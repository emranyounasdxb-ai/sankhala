{
  "name": "sankhala",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
