# Leave disabled until the complete site and approved content are ready to launch.
SEO_INDEXABLE=false
# Official domain confirmed by the user. Also used as the application's default.
SITE_URL=https://sankhala.ae

# ATS: configure privately, then enable the recruitment backend.
ATS_ENABLED=false
ATS_DB_HOST=127.0.0.1
ATS_DB_PORT=3306
ATS_DB_NAME=sankhala_ats
ATS_DB_USER=
ATS_DB_PASSWORD=
BETTER_AUTH_SECRET=
ATS_HEALTH_TOKEN=
ATS_PRIVATE_ROOT=/home/sankhala/private/sankhala-ats
ATS_RETENTION_DAYS=365
ATS_BACKUP_KEY=
ATS_BACKUP_RETENTION_DAYS=30
ATS_AV_COMMAND=
ATS_AV_DATABASE=
ATS_AV_LIBRARY_PATH=
ATS_AV_CERTIFICATES=
# Designated by the owner; this does not automatically create an account.
ATS_INITIAL_ADMIN_EMAIL=admin@sankhala.ae
ATS_HR_EMAIL=admin@sankhala.ae
ATS_PUBLIC_ORIGIN=https://sankhala.ae
# Populate securely after the existing hosting/mail service is identified.
ATS_SMTP_HOST=
ATS_SMTP_PORT=465
ATS_SMTP_USER=
ATS_SMTP_PASSWORD=
ATS_SMTP_FROM=
